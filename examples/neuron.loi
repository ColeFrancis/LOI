//
//    AXON(potential) := spike_out;
//}

rel_t SYNAPSE(spike_in: Impulse, weight: Float) -> Float = {
    cases spike_in {
        true : weight,
        _ : 0,
    }
};

rel_t BODY(potential: Float, incoming_potential: Float, spiking: Impulse) -> Float = {
    let refrac_potential = 0;
    let tau = 0.1;
    
    cases spiking {
        true: refrac_potential,
        _ : potential * (1-tau) + incoming_potential,
    }
};

rel_t AXON(potential: Float) -> Impulse = {
    let threshold = 2;

    potential >= threshold
};

net Neuron {
    input spike_in: Impulse;

    output spike_out: Impulse;
    output potential: Float;
    output incoming_potential: Float;

    init weight: Float = 1;
    init potential: Float = 0;

    SYNAPSE(spike_in, weight) := incoming_potential;

    BODY(potential, incoming_potential, spike_out) := potential;

    AXON(potential) := spike_out;
}